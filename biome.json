{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!crates",
      "!dist",
      "!target",
      "!eval/out",
      "!eval/baselines",
      "!e2e/out",
      "!e2e/tmp",
      "!site/.next",
      "!site/out",
      "!site/node_modules",
      "!site/lib/chimera-kit",
      "!site/next-env.d.ts",
      "!.claude",
      "!**/*.generated.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["site/lib/chimera-visual/vendor/**"],
      "linter": { "enabled": false }
    }
  ]
}
